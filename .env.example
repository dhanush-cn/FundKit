# FundKit environment reference
# Engineered by Dhanush C N (github.com/dhanush-cn)
#
# Every variable is namespaced with FUNDKIT_ so services can share a host or a
# Kubernetes pod without colliding with unrelated configuration. The pre-refactor
# names (PORT, DB_URL, ...) are still honoured as a fallback during migration.

# ---- shared ----
FUNDKIT_LOG_LEVEL=info
FUNDKIT_SHUTDOWN_TIMEOUT=15s
# Every service serves /metrics from a dedicated admin listener on this port,
# separate from the port that serves customer traffic. One port convention
# across the fleet keeps the Prometheus scrape config to five lines per service.
FUNDKIT_METRICS_PORT=9100

# ---- api-gateway ----
FUNDKIT_HTTP_PORT=8080
FUNDKIT_JWT_SECRET=fundkit-local-dev-secret-change-me
FUNDKIT_JWT_TTL=24h
# The gateway stores user accounts (username, bcrypt hash, email, phone).
FUNDKIT_DB_URL=postgres://fundkit:password@postgres:5432/fundkit_db?sslmode=disable
# bcrypt work factor: raise it as hardware gets faster.
FUNDKIT_BCRYPT_COST=10
FUNDKIT_ORDER_SERVICE_URL=http://order-service:8081
FUNDKIT_CORS_ALLOWED_ORIGINS=http://localhost:5173
FUNDKIT_RATE_LIMIT_RPS=5
FUNDKIT_RATE_LIMIT_BURST=10

# ---- order-service ----
# Either supply a full DSN...
FUNDKIT_DB_URL=postgres://fundkit:password@postgres:5432/fundkit_db?sslmode=disable
# ...or the discrete parts, which is what most managed Postgres secrets provide:
# FUNDKIT_DB_HOST=postgres
# FUNDKIT_DB_PORT=5432
# FUNDKIT_DB_USER=fundkit
# FUNDKIT_DB_PASSWORD=password
# FUNDKIT_DB_NAME=fundkit_db
# FUNDKIT_DB_SSLMODE=disable
FUNDKIT_REDIS_URL=redis:6379
FUNDKIT_KAFKA_BROKERS=kafka:9092
FUNDKIT_KAFKA_ORDER_TOPIC=order_events
FUNDKIT_IDEMPOTENCY_TTL=24h
FUNDKIT_PORTFOLIO_GRPC_URL=portfolio-service:50051
# Transactional outbox relay. Orders and their events are committed together;
# this worker is what moves the committed events onto Kafka.
FUNDKIT_OUTBOX_POLL_INTERVAL=1s
FUNDKIT_OUTBOX_BATCH_SIZE=100
# Publish failures before a record is retired to FAILED and stops being retried.
FUNDKIT_OUTBOX_MAX_ATTEMPTS=10
FUNDKIT_OUTBOX_MAX_BACKOFF=30s
# How long shutdown waits for the relay to flush what was just committed.
FUNDKIT_OUTBOX_SHUTDOWN_FLUSH=5s

# ---- portfolio-service ----
FUNDKIT_GRPC_PORT=50051
FUNDKIT_NAV_CACHE_TTL=30s

# ---- notification-service ----
FUNDKIT_KAFKA_CONSUMER_GROUP=fundkit-notification-workers
# Dead-letter queue. A message that cannot be processed is republished here
# verbatim, with the failure reason, attempt count and origin offset attached as
# headers, and only then is its offset committed. Must differ from
# FUNDKIT_KAFKA_ORDER_TOPIC; the service refuses to start otherwise.
FUNDKIT_KAFKA_DLQ_TOPIC=order_events_dlq
# Handler attempts before a message is dead-lettered, counting the first try.
# Errors marked permanent (bad payload, unknown schema version) skip retries.
FUNDKIT_KAFKA_MAX_ATTEMPTS=3
# Base delay between attempts; doubled each time. Retries are in-process, so the
# partition is stalled for the duration — keep this short.
FUNDKIT_KAFKA_RETRY_BACKOFF=200ms

# ---- frontend ----
VITE_API_BASE_URL=http://localhost:8080
